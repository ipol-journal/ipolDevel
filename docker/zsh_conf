##################
#     Zsh        #
##################
export ZSH=/home/ipol/.oh-my-zsh

ZSH_THEME="jtriley"

plugins=()

source $ZSH/oh-my-zsh.sh

##################
#     Alias      #
##################

# IPOL quick launch
alias ipolDevel="core & demorunner & cp2devel"

# Control Panel
alias cp2="cd ~/ipolDevel/cp2 && uv run ./gunicorn_start_cp2"
alias cp2devel="cd ~/ipolDevel/cp2 && uv run python ControlPanel/manage.py runserver 127.0.0.1:8002"
alias venvcp2="cd ~/ipolDevel/cp2 && source bin/activate"

# Collect all static files from CP.
alias collectstatic="cd ~/ipolDevel/cp2/ControlPanel && uv run python manage.py collectstatic --noinput --clear"

# Test all
alias runtest="cd ~/ipolDevel/ci_tests && python3 all.py"

# Go to run directory
alias rund="cd ~/ipolDevel/shared_folder/run/"

# Activate venv
alias venv="source venv/bin/activate"

function demo_copy() {
    cd ~/ipolDevel/tools/demo_copy && ./demo_copy.py $1 $2
}


# Modules start
alias core="cd ~/ipolDevel/ipol_demo/modules/core && uv run uvicorn app:app --reload --host 127.0.0.1 --port 8080"
alias demorunner="cd ~/ipolDevel/ipol_demo/modules/demorunner && uv run uvicorn demorunner:app --reload --host 0.0.0.0 --port 9004"